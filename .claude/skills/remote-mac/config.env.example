# Copy to config.env (git-ignored) and adjust. Sourced by scripts/remote-mac.sh.

# macOS host and account; authentication uses your ssh-agent.
REMOTE_HOST=192.168.0.10
REMOTE_USER=user

# Extra ssh options, for example a key or port: SSH_OPTS="-i ~/.ssh/mac_key -p 22"
SSH_OPTS=""

# Remote copy lives in ~/$REMOTE_BASE/$PROJECT_NAME (PROJECT_NAME defaults to the repo folder name).
REMOTE_BASE=proj/remote
#PROJECT_NAME=star-debug

# Flutter app directory inside the repository.
APP_DIR=star.debug

# Shell code run on the Mac before each command, for secrets or tool overrides,
# for example: REMOTE_ENV='export FASTLANE_USER=...'
REMOTE_ENV=""

# Fastlane secrets file, relative to APP_DIR; git-ignored, so copy it with the env command.
#ENV_FILE=ios/.env.default
